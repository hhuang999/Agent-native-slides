# Copy this file to .env in the project root. .env is ignored by Git.
# Image generation is optional; leave the key empty for ordinary slide decks.

# aihubmix (default when omitted) or openai-compatible.
IMAGE_PROVIDER=aihubmix

# Full image generation endpoint, not just the API host.
# AIHubMix default: https://aihubmix.com/ai/v1/images/generations
# For openai-compatible, set your service's POST /images/generations URL.
# IMAGE_API_URL=https://aihubmix.com/ai/v1/images/generations

# Secret for the selected service. Required only when running imagegen.js.
# For AIHubMix, the legacy AIHUBMIX_API_KEY shell variable also works.
IMAGE_API_KEY=

# Model ID. AIHubMix defaults to gpt-image-2.5-sunburst when omitted.
# Required for openai-compatible unless --model is passed to imagegen.js.
# IMAGE_MODEL=gpt-image-2.5-sunburst
